{
  "name": "Archers-Notes",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "npx turbo run build",
    "dev": "npx turbo run dev",
    "lint": "npx turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "npx turbo run check-types",
    "test": "npx turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.11.10",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "npm": "^11.19.0"
  }
}
